#!/usr/bin/env bash
#
# fyaisa: FYAISA hub client
#
# Lists, builds and installs homebrew from the FYAISA catalog onto Vega OS
# Fire TV devices.
#
#   fyaisa list                      show the catalog
#   fyaisa search <term>             filter by name/tag/description
#   fyaisa info <app-id>             show one app in detail
#   fyaisa install <app-id>          build if needed, then install on the device
#   fyaisa update <app-id>           rebuild a locally-edited app and reinstall
#   fyaisa uninstall <app-id>        remove from the device
#   fyaisa add-app <name>            scaffold a new app from a template
#   fyaisa devices                   list Fire TVs visible to the Vega CLI
#   fyaisa connect [--lan] [--port N] [--tunnel] [--no-forward]
#                                     start the ElevSH bridge: pair this PC with
#                                     a Fire TV so the TV app can queue installs
#                                     and gate which apps may connect (FYAISA).
#                                     --lan also reverse-tunnels the port so the
#                                     hub can Discover this PC with no IP to type
#   fyaisa disconnect [--port N]      stop the ElevSH bridge started by connect
#   fyaisa approve <code>            approve the pairing code shown on the TV
#
# Options:
#   --repo <url>     catalog repo (default: https://github.com/AaronYTDev/FYAISA)
#   --dir <path>     local FYAISA checkout to build from (default: fetch from GitHub)
#   --ip <host:port> target a specific device
#   --debug          keep going and show more output
#
# Apps are fetched from GitHub by default. Use --dir to build from a local clone.
#
# WHY INSTALLING HAPPENS HERE: a Vega app cannot install other .vpkg packages.
# Package management is a host-side operation (vega device install-app). So this
# CLI is the installer; the on-device FYAISA app is the catalog and downloader.
#
set -uo pipefail

# Resolve through symlinks: when installed as ~/.local/bin/fyaisa -> repo/fyaisa,
# $0 is the symlink, so SCRIPT_DIR would point at ~/.local/bin and every
# relative path (catalog.json, bridge/) would be wrong.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
REPO_URL="https://github.com/AaronYTDev/FYAISA"
LOCAL_DIR="${FYAISA_DIR:-$SCRIPT_DIR}"
STATE_DIR="$HOME/.fyaisa" # shared with the bridge (bridge.json lives here)
DEVICE_IP=""
BUILD_TYPE="Release"
DEBUG=0
NODE_BIN="$HOME/.local/nodejs/node-v22.23.3-linux-x64/bin"

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYN=$'\033[36m'; DIM=$'\033[2m'; RST=$'\033[0m'

# Status goes to stderr. Some callers capture a helper's stdout to get a
# value back (app_src_dir prints a path), so progress lines must not land in
# the captured result.
info() { printf '%s==>%s %s\n' "$CYN" "$RST" "$1" >&2; }
warn() { printf '%s[warn]%s %s\n' "$YEL" "$RST" "$1" >&2; }
ok()   { printf '%s[ok]%s %s\n' "$GRN" "$RST" "$1" >&2; }
die()  { printf '%s[error]%s %s\n' "$RED" "$RST" "$1" >&2; exit 1; }

# --- dependencies ------------------------------------------------------------
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found. $2"; }
need_vega() {
  need vega "Install the Vega SDK: curl -fsSL https://sdk-installer.vega.labcollab.net/get_vvm.sh | bash && source ~/vega/env"
}
setup_env() {
  [[ -d "$NODE_BIN" ]] && export PATH="$NODE_BIN:$PATH"
  need_vega
  need curl "Install curl."
  need python3 "Install python3 (used to read catalog.json)."
}

# --- args --------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO_URL="$2"; shift 2 ;;
    --dir)  LOCAL_DIR="$2"; shift 2 ;;
    --ip)   DEVICE_IP="$2"; shift 2 ;;
    --debug) DEBUG=1; shift ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done
CMD="${1:-list}"; shift || true

catalog_url() { printf '%s/raw/main/catalog.json' "${REPO_URL%.git}"; }

fetch_catalog() {
  local cache url
  cache="$(mktemp)"; url="$(catalog_url)"
  curl -fsSL "$url" -o "$cache" 2>/dev/null || {
    [[ -f "$LOCAL_DIR/catalog.json" ]] && { cat "$LOCAL_DIR/catalog.json"; return 0; }
    die "Could not fetch $url and no local catalog at $LOCAL_DIR/catalog.json"
  }
  cat "$cache"; rm -f "$cache"
}

# Query the catalog with python3 (jq is not guaranteed to be installed).
# NOTE: the script is passed with -c, not a heredoc, because the catalog itself
# arrives on stdin.
PY_QUERY=$(cat <<'PY'
import json, sys
mode = sys.argv[1]
apps = json.load(sys.stdin).get("apps", [])
term = (sys.argv[2] if len(sys.argv) > 2 else "").lower()

def f(a, k, d=""):
    v = a.get(k, d)
    return d if v is None else v

if mode == "list":
    for a in apps:
        print("{:<30} {:<16} {}".format(f(a,'id'), f(a,'name'), f(a,'status','?')))
        s = f(a,'summary')
        if s:
            print("  " + s)
        tags = a.get("tags", [])
        if tags:
            print("  tags: " + ", ".join(tags))
        print()
elif mode == "search":
    hits = 0
    for a in apps:
        hay = " ".join([f(a,'id'), f(a,'name'), f(a,'summary'), f(a,'description')] + a.get("tags", [])).lower()
        if term in hay:
            hits += 1
            print("{:<30} {:<16} {}".format(f(a,'id'), f(a,'name'), f(a,'summary')))
    if not hits:
        print("no matches")
elif mode == "info":
    want = sys.argv[2]
    a = next((x for x in apps if x.get("id") == want), None)
    if not a:
        print("NOTFOUND"); sys.exit(3)
    for k in ("id","name","summary","description","license","author","homepage",
              "minOsVersion","targetOsVersion","architectures","status","version",
              "updated","path"):
        v = a.get(k)
        if isinstance(v, list):
            v = ", ".join(map(str, v))
        if v:
            print("{}: {}".format(k, v))
    if a.get("tags"):
        print("tags: " + ", ".join(a["tags"]))
    for n in a.get("notes", []):
        print("note: " + n)
PY
)

cat_query() {
  local mode="$1"; shift
  python3 -c "$PY_QUERY" "$mode" "$@"
}

app_field() {
  fetch_catalog | python3 -c "
import json,sys
d=json.load(sys.stdin); want=sys.argv[1]; field=sys.argv[2]
a=next((x for x in d.get('apps',[]) if x.get('id')==want), None)
print('' if a is None else a.get(field,''))" "$1" "$2"
}

app_path() { app_field "$1" path; }

# The version an app's checkout declares (its manifest.toml). Empty when the
# app isn't there or has no version line.
app_version() {
  sed -n 's/^version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$1/manifest.toml" 2>/dev/null | head -n1
}

# Numeric dotted compare: -1, 0 or 1 for $1 against $2. Anything non-numeric
# counts as 0, so 1.5 and 1.5.0 are the same.
version_cmp() {
  local -a av bv; local i x y
  IFS=. read -r -a av <<< "$1"
  IFS=. read -r -a bv <<< "$2"
  for ((i = 0; i < ${#av[@]} || i < ${#bv[@]}; i++)); do
    x="${av[i]:-0}"; y="${bv[i]:-0}"
    x="${x//[!0-9]/}"; y="${y//[!0-9]/}"
    x=$((10#${x:-0})); y=$((10#${y:-0}))
    (( x < y )) && { printf '%s' -1; return; }
    (( x > y )) && { printf '%s' 1; return; }
  done
  printf '%s' 0
}

# --- device ------------------------------------------------------------------
# `vega device …` needs a live vda link, and that link drops whenever the
# stick sleeps. So reconnect on every lookup: to --ip when one was given,
# else to the last address we saw (saved in ~/.fyaisa/last-device). Without
# the saved address an install straight after the TV wakes dies with
# "device offline" even though the Fire TV is right there.
device_targets() {
  local addrs saved
  if [[ -n "$DEVICE_IP" ]]; then
    vega exec vda connect "$DEVICE_IP" >/dev/null 2>&1
  fi
  addrs="$(vega device list 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]+')"
  if [[ -z "$addrs" && -z "$DEVICE_IP" ]]; then
    saved="$(cat "$STATE_DIR/last-device" 2>/dev/null || true)"
    if [[ -n "$saved" ]]; then
      vega exec vda connect "$saved" >/dev/null 2>&1
      addrs="$(vega device list 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]+')"
    fi
  fi
  if [[ -n "$addrs" ]]; then
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$addrs" | head -n1 > "$STATE_DIR/last-device"
  fi
  printf '%s' "$addrs"
}

require_device() {
  local addrs; addrs="$(device_targets)"
  [[ -n "$addrs" ]] || die "No Vega device found. Enable Developer Mode and set Connection mode to TCP/IP, then run: fyaisa devices"
  ok "Device: $(printf '%s' "$addrs" | tr '\n' ' ')"
}

# --- app source --------------------------------------------------------------
# Apps live in apps/<dir>/ and are full Vega projects, exactly like VegaTube.
# By default, fetch the app source from GitHub so you don't need a local clone.
# Use --dir to build from a local checkout instead.
APP_CACHE_DIR="$HOME/.fyaisa/app-cache"

fetch_app_source() {
  local rel="$1"
  local cache_dir="$APP_CACHE_DIR/$rel"
  local tarball_url="https://github.com/AaronYTDev/FYAISA/archive/refs/heads/main.tar.gz"

  mkdir -p "$APP_CACHE_DIR"

  if [[ -d "$cache_dir" ]]; then
    # Update: pull latest from GitHub
    info "Updating $rel from GitHub…"
    (
      cd "$cache_dir" || exit 1
      git fetch --depth 1 origin main 2>/dev/null && git reset --hard origin/main 2>/dev/null
    ) || {
      # Not a git repo or fetch failed: re-download
      rm -rf "$cache_dir"
      _download_app_source "$rel" "$cache_dir" "$tarball_url" || return 1
    }
  else
    _download_app_source "$rel" "$cache_dir" "$tarball_url" || return 1
  fi

  printf '%s' "$cache_dir"
}

_download_app_source() {
  local rel="$1" cache_dir="$2" tarball_url="$3"
  local tmp; tmp="$(mktemp -d)"
  # The RETURN trap is not scoped to this function: leave it set and it fires
  # again on the caller's return, where tmp is gone and set -u blows up.
  trap 'rm -rf "$tmp"; trap - RETURN' RETURN

  info "Downloading $rel from GitHub…"
  curl -fsSL "$tarball_url" -o "$tmp/repo.tar.gz" || return 1

  # Extract just the app directory from the tarball
  mkdir -p "$cache_dir"
  tar -xzf "$tmp/repo.tar.gz" -C "$tmp" --wildcards "FYAISA-main/$rel/*" 2>/dev/null || {
    # Fallback: extract everything and copy
    tar -xzf "$tmp/repo.tar.gz" -C "$tmp" 2>/dev/null || return 1
    rm -rf "$cache_dir"
    mkdir -p "$cache_dir"
    cp -r "$tmp/FYAISA-main/$rel"/* "$cache_dir/" 2>/dev/null || return 1
  }

  # Move files from the nested directory if needed
  if [[ -d "$tmp/FYAISA-main/$rel" ]]; then
    rm -rf "$cache_dir"
    mkdir -p "$cache_dir"
    cp -r "$tmp/FYAISA-main/$rel"/* "$cache_dir/"
  fi

  rm -rf "$tmp"
  return 0
}

app_src_dir() {
  local rel; rel="$(app_path "$1")"
  [[ -n "$rel" ]] || die "App '$1' is not in the catalog."

  # Which local checkout is in play, if any: an explicit --dir (or FYAISA_DIR),
  # or the checkout this script lives in.
  local local_dir=""
  if [[ -n "$LOCAL_DIR" && -d "$LOCAL_DIR/$rel" && "$LOCAL_DIR" != "$SCRIPT_DIR" ]]; then
    local_dir="$LOCAL_DIR/$rel"
  elif [[ -d "$LOCAL_DIR/$rel" && -f "$LOCAL_DIR/.git/HEAD" ]]; then
    local_dir="$LOCAL_DIR/$rel"
  fi

  # Build from that checkout, but only while it isn't behind the version the
  # catalog publishes — a stale clone would build the old version the catalog
  # just offered to replace.
  if [[ -n "$local_dir" ]]; then
    local have want
    have="$(app_version "$local_dir")"
    want="$(app_field "$1" version)"
    if [[ -n "$have" && -n "$want" && "$(version_cmp "$have" "$want")" = "-1" ]]; then
      info "Local $rel is $have, catalog has $want — fetching from GitHub"
    else
      printf '%s' "$local_dir"
      return
    fi
  fi

  fetch_app_source "$rel"
}

build_app() {
  local id="$1" dir="$2"
  info "Building $id from $dir"
  (
    cd "$dir" || exit 1
    if [[ ! -d node_modules ]]; then
      info "Installing dependencies (first run)…"
      npm install --no-audit --no-fund || exit 1
    fi
    if [[ $DEBUG -eq 1 ]]; then
      npm run "build:$(tr '[:upper:]' '[:lower:]' <<<"$BUILD_TYPE")"
    else
      npm run "build:$(tr '[:upper:]' '[:lower:]' <<<"$BUILD_TYPE")" 2>&1 | tail -15
    fi
  ) || die "Build failed for $id"
  ok "Build finished"
}

# --- commands ----------------------------------------------------------------
cmd_list() {
  local c; c="$(fetch_catalog)"
  printf '%s' "$c" | cat_query list
}

cmd_search() {
  [[ -n "$1" ]] || die "Usage: fyaisa search <term>"
  fetch_catalog | cat_query search "$1"
}

cmd_info() {
  [[ -n "$1" ]] || die "Usage: fyaisa info <app-id>"
  local out; out="$(fetch_catalog | cat_query info "$1")"
  [[ "$out" == "NOTFOUND" ]] && die "App '$1' not found in catalog."
  printf '%s\n' "$out"
}

cmd_install() {
  [[ $# -ge 1 ]] || die "Usage: fyaisa install <app-id>"
  local id="$1"
  cmd_info "$id" >/dev/null
  require_device
  # Resolve the source folder exactly once, before building. app_src_dir can
  # re-download the app, and a re-download wipes the build output, so calling
  # it again after build_app would delete buildinfo.json out from under vega.
  local dir; dir="$(app_src_dir "$id")"
  build_app "$id" "$dir"
  info "Installing $id on the device"
  if [[ -n "$DEVICE_IP" ]]; then
    (cd "$dir" && vega device install-app --dir . -b "$BUILD_TYPE" --device "$DEVICE_IP") || die "Install failed for $id"
  else
    (cd "$dir" && vega device install-app --dir . -b "$BUILD_TYPE") || die "Install failed for $id"
  fi
  ok "Installed $id"
}

cmd_update() {
  [[ $# -ge 1 ]] || die "Usage: fyaisa update <app-id>"
  info "Rebuilding $1 from your local checkout and reinstalling"
  (cd "$LOCAL_DIR" && git pull --ff-only 2>/dev/null) || warn "git pull skipped/failed (continuing with local copy)"
  cmd_install "$1"
}

cmd_uninstall() {
  [[ $# -ge 1 ]] || die "Usage: fyaisa uninstall <component-id>"
  info "Uninstalling $1"
  if [[ -n "$DEVICE_IP" ]]; then
    vega device uninstall-app --appName "$1" --device "$DEVICE_IP"
  else
    vega device uninstall-app --appName "$1"
  fi
  ok "Removed $1"
}

# ---------------------------------------------------------------------------
# ElevSH discovery tunnel
#
# `vega device start-port-forwarding --forward false` is a reverse forward: it
# makes the bridge reachable on the Fire TV's own loopback over the existing
# vda link. That is what lets the hub's "Discover" button find this PC with
# nothing to type. It needs a Fire TV the Vega CLI can see, so it is
# best-effort — without one the manual address box still works.
# ---------------------------------------------------------------------------
start_reverse_forward() {
  local port="$1"
  command -v vega >/dev/null 2>&1 || return 1
  # Reverse forward: the Fire TV reaches this PC on 127.0.0.1:<port>. Re-running
  # is harmless (it just replaces the entry).
  if vega device start-port-forwarding --port "$port" --forward false >/dev/null 2>&1; then
    return 0
  fi
  # It may refuse because the forward already exists; that still counts.
  vega device is-port-forwarded --port "$port" --forward false >/dev/null 2>&1
}

stop_reverse_forward() {
  local port="$1"
  command -v vega >/dev/null 2>&1 || return 0
  vega device stop-port-forwarding --port "$port" --forward false >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# connect — pair a Fire TV with this PC so the TV can queue installs
# ---------------------------------------------------------------------------
cmd_connect() {
  local port=47821 lan=0 tunnel=0 no_forward=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)   port="$2"; shift 2 ;;
      --lan)    lan=1; shift ;;
      --tunnel) tunnel=1; shift ;;
      --no-forward) no_forward=1; shift ;;
      --hub)    LOCAL_DIR="$2"; shift 2 ;;
      *) die "Unknown option for connect: $1" ;;
    esac
  done

  need_vega
  [[ -d "$NODE_BIN" ]] && export PATH="$NODE_BIN:$PATH"
  need node "Install Node.js 18+."

  # Does the hub dir look like a checkout?
  if [[ ! -f "$LOCAL_DIR/catalog.json" ]]; then
    warn "No catalog.json in $LOCAL_DIR — the bridge will report an empty catalog."
    warn "Clone the hub:  git clone $REPO_URL $LOCAL_DIR"
  fi

  local args=("$LOCAL_DIR/bridge/bridge.js" "--port" "$port" "--hub-dir" "$LOCAL_DIR")
  [[ $lan -eq 1 ]] && args+=("--lan")
  [[ $tunnel -eq 1 ]] && args+=("--tunnel")

  if [[ ! -f "$LOCAL_DIR/bridge/bridge.js" ]]; then
    die "Bridge not found at $LOCAL_DIR/bridge/bridge.js"
  fi

  # Reverse-tunnel the port so the Fire TV can reach the bridge on its own
  # loopback, which is what makes FYAISA → ElevSH → Discover work with no
  # address to type. Needs a Fire TV the Vega CLI can see; without one we only
  # lose the shortcut, not the ability to pair.
  if [[ $lan -eq 1 && $no_forward -eq 0 ]]; then
    local addrs; addrs="$(device_targets)"
    if [[ -z "$addrs" ]]; then
      warn "No Fire TV visible to the Vega CLI — skipping the discovery tunnel."
      warn "  Connect one first: vega exec vda connect <stick-ip>:5555"
    elif start_reverse_forward "$port"; then
      ok "Discovery tunnel ready — on the Fire TV: FYAISA → ElevSH → Discover."
    else
      warn "Could not open the discovery tunnel — enter this PC's address in FYAISA → ElevSH instead."
    fi
  fi

  exec node "${args[@]}"
}

# ---------------------------------------------------------------------------
# disconnect — stop a running ElevSH bridge (`fyaisa connect` in another
# terminal / nohup'd). Asks politely over HTTP first, then falls back to
# terminating the process for local bridges.
# ---------------------------------------------------------------------------
cmd_disconnect() {
  local port=47821 host=127.0.0.1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --host) host="$2"; shift 2 ;;
      *) die "Unknown option for disconnect: $1" ;;
    esac
  done
  need curl
  [[ -d "$NODE_BIN" ]] && export PATH="$NODE_BIN:$PATH"

  # Read the token the bridge itself persists (~/.fyaisa/bridge.json) so the
  # shutdown call authenticates like any other host-tool request. Never printed.
  local state="$HOME/.fyaisa/bridge.json" token=""
  if [[ -f "$state" ]]; then
    token="$(python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("token",""))
except Exception:
    pass' "$state" 2>/dev/null || true)"
  fi

  local args=(-sS --max-time 5 -X POST "http://$host:$port/shutdown"
              -H 'Content-Type: application/json')
  [[ -n "$token" ]] && args+=(-H "X-FYAISA-Token: $token")

  local out=""
  if out="$(curl "${args[@]}" 2>&1)" && grep -q '"ok":true' <<<"$out"; then
    stop_reverse_forward "$port"
    ok "ElevSH bridge on $host:$port stopped."
    return 0
  fi

  # HTTP failed (unreachable, stale token, bridge built before /shutdown
  # existed): for a local bridge, terminate the process directly.
  case "$host" in
    127.0.0.1|localhost|::1|"")
      command -v pgrep >/dev/null 2>&1 ||
        die "Could not reach the bridge and pgrep is unavailable — stop its terminal (Ctrl+C) instead."
      local p c keep=""
      for p in $(pgrep -f 'bridge/bridge\.js' 2>/dev/null || true); do
        # Never ourselves or our parent: a wrapper shell whose argv echoes
        # this script's own arguments (e.g. bash -c '… bridge.js --port N …')
        # matches the pattern too — killing it would take down the terminal
        # running the disconnect.
        [[ "$p" == "$$" || "$p" == "$PPID" ]] && continue
        c="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null || true)"
        if [[ "$c" == *"--port "* ]]; then
          [[ "$c" == *"--port $port"* ]] || continue
        else
          # Started without --port: only matches the default port.
          [[ "$port" == 47821 ]] || continue
        fi
        keep+="$p "
      done
      if [[ -n "$keep" ]]; then
        # shellcheck disable=SC2086
        kill $keep 2>/dev/null || true
        sleep 1
        for p in $keep; do kill -9 "$p" 2>/dev/null || true; done
        stop_reverse_forward "$port"
        ok "ElevSH bridge on port $port stopped."
        return 0
      fi
      stop_reverse_forward "$port"
      warn "No bridge is running on $host:$port."
      return 0
      ;;
    *)
      die "Could not reach the bridge at $host:$port (${out:-no response})"
      ;;
  esac
}

cmd_approve() {
  local code="${1:-}" port=47821 host=127.0.0.1
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --host) host="$2"; shift 2 ;;
      *) die "Unknown option for approve: $1" ;;
    esac
  done
  [[ "$code" =~ ^[0-9]{6}$ ]] || die "Usage: fyaisa approve <6-digit-code> [--port N] [--host H]"
  need curl
  local out
  if ! out="$(curl -sS --max-time 10 -X POST "http://$host:$port/pair/approve" \
      -H 'Content-Type: application/json' \
      -d "{\"code\":\"$code\",\"device\":\"fyaisa-cli\"}" 2>&1)"; then
    die "Could not reach the bridge at $host:$port — is 'fyaisa connect' running? ($out)"
  fi
  if grep -q '"ok":true' <<<"$out"; then
    info "Approved — the Fire TV received its pairing token."
    printf '%b\n' "${DIM}The Install button appears in the FYAISA app now.${RST}"
  else
    die "Bridge refused the code: $out"
  fi
}

cmd_devices() {
  info "Fire TVs visible to the Vega CLI"
  vega device list
  local addrs; addrs="$(device_targets)"
  if [[ -z "$addrs" ]]; then
    warn "None found. Check Developer Mode + Connection mode TCP/IP, then:"
    warn "  vega exec vda connect <ip>:5555"
  fi
}

cmd_add_app() {
  [[ $# -ge 1 ]] || die "Usage: fyaisa add-app <name> [--template vegatube|snake|doom|fileexplorer]"
  local name="$1"
  local template="${2:-vegatube}"
  local slug; slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
  [[ -n "$slug" ]] || die "Invalid app name: $name"

  local dir="apps/$slug"
  if [[ -d "$dir" ]]; then
    die "App directory already exists: $dir"
  fi

  info "Creating new app: $name ($dir)"

  # Copy template
  case "$template" in
    vegatube) cp -r "$SCRIPT_DIR/apps/vegatube" "$dir" ;;
    snake) cp -r "$SCRIPT_DIR/apps/snake" "$dir" ;;
    doom) cp -r "$SCRIPT_DIR/apps/doom" "$dir" ;;
    fileexplorer) cp -r "$SCRIPT_DIR/apps/fileexplorer" "$dir" ;;
    *) die "Unknown template: $template (use: vegatube, snake, doom, fileexplorer)" ;;
  esac

  # Remove build artifacts
  rm -rf "$dir/node_modules" "$dir/build" "$dir/buildinfo.json"

  # Update manifest
  sed -i "s/title = \".*\"/title = \"$name\"/" "$dir/manifest.toml"
  sed -i "s/id = \".*\"/id = \"app.$slug\"/" "$dir/manifest.toml"

  # Update package.json
  sed -i "s/\"name\": \".*\"/\"name\": \"@fyaisa\/$slug\"/" "$dir/package.json"
  sed -i "s/\"version\": \".*\"/\"version\": \"1.0.0\"/" "$dir/package.json"

  # Update app.json
  cat > "$dir/app.json" <<EOF
{
  "//": "The declared app name must follow this pattern to be KRL-compatible",
  "name": "app.$slug.main",
  "displayName": "$name"
}
EOF

  # Add to catalog.json
  python3 -c "
import json
with open('$SCRIPT_DIR/catalog.json', 'r') as f:
    cat = json.load(f)
new_app = {
    'id': 'app.$slug.main',
    'name': '$name',
    'summary': 'TODO: Add a one-line summary.',
    'description': 'TODO: Add a full description.',
    'path': 'apps/$slug',
    'license': 'GPL-3.0-only',
    'author': 'FYAISA contributors',
    'homepage': 'https://github.com/AaronYTDev/FYAISA',
    'minOsVersion': '1.2',
    'targetOsVersion': '1.2',
    'architectures': ['armv7', 'aarch64', 'x86_64'],
    'tags': [],
    'containsAds': False,
    'requiresNetwork': True,
    'drm': False,
    'status': 'beta',
    'version': '1.0.0',
    'updated': '2026-10-10',
    'install': {
        'kind': 'vpkg-release',
        'release': 'https://api.github.com/repos/AaronYTDev/FYAISA/releases',
        'note': 'Prebuilt .vpkg is published on the FYAISA releases page. If no matching build exists, the host installer builds it from apps/$slug with the Vega SDK.'
    },
    'notes': [
        'TODO: Add notes about this app.',
        'Requires Developer Mode on the Fire TV; not installable from the Amazon Appstore.'
    ]
}
cat['apps'].insert(0, new_app)
with open('$SCRIPT_DIR/catalog.json', 'w') as f:
    json.dump(cat, f, indent=2)
    f.write('\n')
"

  ok "App created at $dir"
  info "Next steps:"
  info "  1. Edit $dir/manifest.toml with your app details"
  info "  2. Edit $dir/src/App.tsx with your app logic"
  info "  3. Update the catalog entry in catalog.json"
  info "  4. Add an icon at $dir/assets/image/$slug.png"
  info "  5. Build and test: fyaisa install app.$slug.main"
  info "  6. Push to GitHub and open a PR"
}

main() {
  setup_env
  case "$CMD" in
    list) cmd_list ;;
    search) cmd_search "${1:-}" ;;
    info) cmd_info "${1:-}" ;;
    install) cmd_install "${1:-}" ;;
    update) cmd_update "${1:-}" ;;
    uninstall) cmd_uninstall "${1:-}" ;;
    add-app) cmd_add_app "$@" ;;
    devices) cmd_devices ;;
    approve) cmd_approve "$@" ;;
    connect) cmd_connect "$@" ;;
    disconnect) cmd_disconnect "$@" ;;
    *) die "Unknown command: $CMD  (try: fyaisa --help)" ;;
  esac
}

main "$@"
