{
  "name": "@fyaisa/tizentube-vega",
  "version": "1.0.0",
  "private": true,
  "description": "Ad-free, sponsor-free YouTube for Vega OS Fire TV Sticks (FYAISA hub app).",
  "author": "TizenTube Vega contributors",
  "license": "GPL-3.0-only",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "build:injection": "node scripts/build-injection.mjs",
    "update:tizentube": "bash scripts/update-tizentube.sh",
    "build:release": "npm-run-all build:injection build:release:vega",
    "build:release:vega": "react-native build-vega --build-type Release",
    "build:debug": "npm-run-all build:injection build:debug:vega",
    "build:debug:vega": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "install:device": "bash scripts/install-device.sh",
    "doctor": "vega project doctor",
    "fyaisa:install": "bash ../../fyaisa install app.tizentube.vega"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "^19.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "tizentubevega",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronYTDev/FYAISA"
  }
}
